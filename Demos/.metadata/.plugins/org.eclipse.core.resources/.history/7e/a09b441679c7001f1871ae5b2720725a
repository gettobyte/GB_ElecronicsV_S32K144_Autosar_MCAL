/* Including necessary configuration files. */
#include "Mcal.h"
#include "Clock_Ip.h"
#include "Port.h"
#include "Spi.h"
#include "Dio.h"

volatile int exit_code = 0;
/* User includes */
void TimeDelay(int32_t seconds)
{
	while(seconds > 0)
	{
		seconds--;
	}
}

int main(void)
{
	Clock_Ip_StatusType clockStatus;
	/*********************Clock Configuration***********************/
	clockStatus = Clock_Ip_Init(&Mcu_aClockConfigPB_BOARD_InitPeripherals[0]);
	while (clockStatus != CLOCK_IP_SUCCESS)
	{
		clockStatus = Clock_Ip_Init(&Mcu_aClockConfigPB_BOARD_InitPeripherals[0]);
	}
	/***************************************************************/

	/* Initialize all pins(PORT and DIO) using the Port driver*/
	Port_Init(NULL_PTR);

	/* Initialize all pins of SPI using the SPI_INIT driver*/
	Spi_Init(&Spi_Config_BOARD_InitPeripherals);


	uint8 temp_var = 0xAA;
	/*TPL1 EN PIN*/
	Dio_WriteChannel(DioConf_DioChannel_TPL1_ENABLE, STD_HIGH);

	/*TPL1 Verification Pulse*/
	Dio_WriteChannel(DioConf_DioChannel_TPL1_INT_PULSE, STD_LOW);
	TimeDelay(4800000);
	Dio_WriteChannel(DioConf_DioChannel_TPL1_INT_PULSE, STD_HIGH);

	/*SPI TX Checker*/
	Std_ReturnType check = Spi_WriteIB(0, &temp_var);
	Std_ReturnType check_1 = Spi_SyncTransmit(0);

    for(;;)
    {
        if(exit_code != 0)
        {
            break;
        }
    }
    return exit_code;
}

